<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Grammar Fix — Correct your text</title>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%238b5cf6'/%3E%3Cpath d='M9 17l4 4 10-10' stroke='white' stroke-width='3' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      *,
      *::before,
      *::after {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      :root {
        --bg: #0a0a0f;
        --glass-bg: rgba(255, 255, 255, 0.04);
        --glass-border: rgba(255, 255, 255, 0.08);
        --glass-hover: rgba(255, 255, 255, 0.07);
        --text-primary: #f1f1f7;
        --text-secondary: rgba(255, 255, 255, 0.5);
        --text-tertiary: rgba(255, 255, 255, 0.25);
        --accent: #8b5cf6;
        --accent-light: #a78bfa;
        --accent-glow: rgba(139, 92, 246, 0.3);
        --accent-subtle: rgba(139, 92, 246, 0.12);
        --success: #34d399;
        --error: #fb7185;
        --blur: 20px;
        --radius: 1.25rem;
      }
      html {
        font-size: 16px;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      body {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: var(--bg);
        color: var(--text-primary);
        min-height: 100dvh;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
      }
      body::before {
        content: '';
        position: fixed;
        inset: 0;
        z-index: -1;
        background:
          radial-gradient(ellipse 80% 60% at 10% 20%, rgba(139, 92, 246, 0.15) 0%, transparent 60%),
          radial-gradient(ellipse 60% 50% at 90% 80%, rgba(99, 102, 241, 0.1) 0%, transparent 60%),
          radial-gradient(ellipse 50% 40% at 50% 50%, rgba(236, 72, 153, 0.05) 0%, transparent 60%);
        pointer-events: none;
      }

      nav {
        padding: 1.5rem 0;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .logo {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        font-weight: 700;
        font-size: 1.125rem;
        color: var(--text-primary);
        text-decoration: none;
        letter-spacing: -0.02em;
      }
      .logo-mark {
        width: 2rem;
        height: 2rem;
        background: linear-gradient(135deg, var(--accent), #6366f1);
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 0.8125rem;
        font-weight: 700;
      }
      .nav-badge {
        font-size: 0.75rem;
        color: var(--text-secondary);
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        padding: 0.375rem 1rem;
        border-radius: 9999px;
        backdrop-filter: blur(var(--blur));
        -webkit-backdrop-filter: blur(var(--blur));
      }

      .hero {
        padding: 1.5rem 0 1rem;
        text-align: center;
      }
      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.875rem;
        background: var(--accent-subtle);
        color: var(--accent-light);
        font-size: 0.6875rem;
        font-weight: 600;
        border-radius: 9999px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 1rem;
        border: 1px solid rgba(139, 92, 246, 0.15);
        opacity: 0;
        animation: fadeUp 0.5s ease-out forwards;
      }
      .hero h1 {
        font-size: clamp(2rem, 4.5vw, 3.25rem);
        font-weight: 700;
        letter-spacing: -0.03em;
        line-height: 1.1;
        color: var(--text-primary);
        opacity: 0;
        animation: fadeUp 0.5s ease-out 0.1s forwards;
      }
      .hero h1 span {
        background: linear-gradient(135deg, var(--accent-light), #818cf8);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }
      .hero p {
        font-size: 1rem;
        color: var(--text-secondary);
        max-width: 32rem;
        margin: 0.5rem auto 0;
        line-height: 1.6;
        font-weight: 400;
        opacity: 0;
        animation: fadeUp 0.5s ease-out 0.2s forwards;
      }

      @keyframes fadeUp {
        from {
          opacity: 0;
          transform: translateY(0.75rem);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .glass {
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: var(--radius);
        padding: 1.25rem;
        backdrop-filter: blur(var(--blur));
        -webkit-backdrop-filter: blur(var(--blur));
        transition: background 0.3s ease, border-color 0.3s ease;
        opacity: 0;
        animation: fadeUp 0.5s ease-out 0.25s forwards;
      }
      .glass:nth-child(2) {
        animation-delay: 0.3s;
      }
      .glass:hover {
        background: var(--glass-hover);
        border-color: rgba(255, 255, 255, 0.12);
      }

      .glass-header {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        margin-bottom: 1rem;
      }
      .glass-icon {
        width: 2rem;
        height: 2rem;
        border-radius: 0.625rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.875rem;
      }
      .glass-icon.purple {
        background: var(--accent-subtle);
        color: var(--accent-light);
      }
      .glass-icon.green {
        background: rgba(52, 211, 153, 0.1);
        color: var(--success);
      }

      .glass-title {
        font-size: 0.9375rem;
        font-weight: 600;
        letter-spacing: -0.01em;
      }
      .glass-sub {
        font-size: 0.75rem;
        color: var(--text-tertiary);
        margin-top: 0.125rem;
      }

      .glass textarea {
        width: 100%;
        height: 280px;
        padding: 0.875rem;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 0.875rem;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 0.9375rem;
        line-height: 1.6;
        color: var(--text-primary);
        background: rgba(0, 0, 0, 0.25);
        resize: vertical;
        outline: none;
        transition: border-color 0.25s ease, box-shadow 0.25s ease;
      }
      .glass textarea:focus {
        border-color: var(--accent);
        box-shadow: 0 0 0 2px var(--accent-glow);
      }
      .glass textarea::placeholder {
        color: var(--text-tertiary);
      }

      .char-row {
        display: flex;
        justify-content: flex-end;
        margin-top: 0.5rem;
        font-size: 0.6875rem;
        color: var(--text-tertiary);
        font-weight: 500;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.75rem 1.5rem;
        border-radius: 9999px;
        font-family: 'Inter', system-ui, sans-serif;
        font-size: 0.875rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        width: 100%;
        margin-top: 1rem;
      }
      .btn:active {
        transform: scale(0.97);
      }
      .btn-primary {
        background: linear-gradient(135deg, var(--accent), #6366f1);
        color: white;
        box-shadow: 0 4px 20px var(--accent-glow);
      }
      .btn-primary:hover {
        box-shadow: 0 6px 28px var(--accent-glow);
        transform: translateY(-1px);
      }
      .btn-primary:active {
        transform: scale(0.97) translateY(0);
      }

      .output-body {
        padding: 1rem;
        border-radius: 0.875rem;
        background: rgba(0, 0, 0, 0.25);
        border: 1px solid rgba(255, 255, 255, 0.06);
        font-size: 0.9375rem;
        line-height: 1.7;
        color: var(--text-primary);
        white-space: pre-wrap;
        word-wrap: break-word;
        min-height: 280px;
      }

      .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        min-height: 160px;
        text-align: center;
        gap: 0.75rem;
        color: var(--text-tertiary);
        font-size: 0.8125rem;
      }
      .empty-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.75rem;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.125rem;
        opacity: 0.6;
      }

      .result-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.75rem;
        background: rgba(52, 211, 153, 0.1);
        color: var(--success);
        font-size: 0.6875rem;
        font-weight: 600;
        border-radius: 9999px;
        border: 1px solid rgba(52, 211, 153, 0.15);
        margin-bottom: 0.75rem;
        width: fit-content;
      }

      .alert {
        padding: 0.75rem 1rem;
        border-radius: 0.875rem;
        font-size: 0.8125rem;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        background: rgba(251, 113, 133, 0.08);
        border: 1px solid rgba(251, 113, 133, 0.15);
        color: var(--error);
        opacity: 0;
        animation: fadeUp 0.4s ease-out forwards;
      }
      .alert-success {
        background: rgba(52, 211, 153, 0.08);
        border-color: rgba(52, 211, 153, 0.15);
        color: var(--success);
      }
      .alert-icon {
        flex-shrink: 0;
        margin-top: 0.125rem;
      }

      footer {
        padding: 1.5rem 0;
        text-align: center;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        margin-top: auto;
        flex-shrink: 0;
      }
      .main-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        padding-bottom: 1.5rem;
      }
      @media (min-width: 768px) {
        .grid {
          grid-template-columns: 1fr 1fr;
          gap: 1.25rem;
        }
      }
      footer p {
        font-size: 0.75rem;
        color: var(--text-tertiary);
      }
      footer a {
        color: var(--text-secondary);
        text-decoration: none;
        font-weight: 500;
        transition: color 0.2s ease;
      }
      footer a:hover {
        color: var(--text-primary);
      }

      @media (max-width: 767px) {
        .main-wrap {
          padding: 0 1rem;
        }
        .hero {
          padding: 1.5rem 0 1rem;
        }
        .glass {
          padding: 1.25rem;
        }
        .glass textarea,
        .output-body {
          min-height: 140px;
          font-size: 0.875rem;
        }
      }
    </style>
  </head>
  <body>
    <div class="main-wrap">
      <nav>
        <a href="/" class="logo">
          <span class="logo-mark">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </span>
          Grammar Fix
        </a>
      </nav>

      <div class="hero">
        <div class="hero-badge">
          <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor"><circle cx="4" cy="4" r="3"/></svg>
          AI-Powered
        </div>
        <h1>Write better, <span>instantly</span></h1>
        <p>AI grammar correction that polishes your writing in seconds.</p>
      </div>

      <% if (error) { %>
        <div class="alert" role="alert">
          <span class="alert-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          </span>
          <div><strong>Note:</strong> <%= error %></div>
        </div>
      <% } %>

      <div class="grid">
        <div class="glass">
          <div class="glass-header">
            <div class="glass-icon purple">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
            </div>
            <div>
              <div class="glass-title">Input</div>
              <div class="glass-sub">Paste your text below</div>
            </div>
          </div>
          <form action="/correct" method="POST">
            <textarea id="text" name="text" rows="6" placeholder="e.g. i goes to the store and buyed some apples"><%= originalText %></textarea>
            <div class="char-row"><span id="charCount">0</span>/5000</div>
            <button type="submit" class="btn btn-primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
              Enhance
            </button>
          </form>
        </div>

        <div class="glass">
          <div class="glass-header">
            <div class="glass-icon green">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <div>
              <div class="glass-title">Output</div>
              <div class="glass-sub">Corrected text appears here</div>
            </div>
          </div>
          <div class="output">
            <% if (hasResult) { %>
              <% if (corrected && corrected !== originalText) { %>
                <div class="result-badge">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                  Corrections applied
                </div>
                <div class="output-body"><%= corrected %></div>
              <% } else { %>
                <div class="output-body">
                  <div class="alert alert-success" style="display:flex;align-items:center;gap:0.5rem;padding:0.75rem 1rem;border-radius:0.75rem;font-size:0.8125rem;margin:0;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                    Your text looks great! No corrections needed.
                  </div>
                </div>
              <% } %>
            <% } else { %>
              <div class="output-body">
                <div class="empty-state">
                  <div class="empty-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M12 18v-6"/><path d="M9 15h6"/></svg>
                  </div>
                  <div>Enter text and click Enhance</div>
                </div>
              </div>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <footer>
      <div style="max-width:1200px;margin:0 auto;padding:0 1.5rem;">
        <p>Powered by LanguageTool &middot; Built with Express</p>
      </div>
    </footer>

    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var ta = document.getElementById('text');
        var cc = document.getElementById('charCount');
        if (ta && cc) {
          cc.textContent = ta.value.length;
          ta.addEventListener('input', function() {
            cc.textContent = this.value.length;
          });
        }
      });
    </script>
  </body>
</html>